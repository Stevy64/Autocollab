# Copier vers /etc/wayize/api.env (mode 600, propriétaire wayize).
# Ne pas commiter le fichier rempli.
DJANGO_SETTINGS_MODULE=wayize_api.prod
DJANGO_SECRET_KEY=remplacer-par-secrets.token_urlsafe-48
WAYIZE_API_HOSTS=127.0.0.1,localhost
WAYIZE_SEED=0
# PostgreSQL dès qu'il y a plus d'un processus API. Sinon, laisser commenté (SQLite).
# DATABASE_URL=postgresql://UTILISATEUR:MOT@HOTE:5432/wayize?sslmode=require
# WAYIZE_SQLITE_PATH=/var/lib/wayize/db.sqlite3
# Web Push (notifications système). Ne jamais committer la clé privée.
# Générer en local : npx web-push generate-vapid-keys
# ou : python deploy/generate_vapid_keys.py
# WAYIZE_VAPID_PUBLIC_KEY=
# WAYIZE_VAPID_PRIVATE_KEY=
# WAYIZE_VAPID_SUBJECT=mailto:contact@wayize.gabomazone.com
