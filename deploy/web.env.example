# Copier vers /etc/wayize/web.env (mode 600, propriétaire wayize).
# Ne pas commiter le fichier rempli. La clé peut différer de celle de l'API.
DJANGO_SETTINGS_MODULE=wayize_web.prod
DJANGO_SECRET_KEY=remplacer-par-une-autre-valeur-longue
WAYIZE_HOSTS=wayize.gabomazone.com
WAYIZE_CSRF_ORIGINS=https://wayize.gabomazone.com
WAYIZE_API_URL=http://127.0.0.1:8648
# WAYIZE_STATIC_ROOT=/srv/wayize/frontend/staticfiles
